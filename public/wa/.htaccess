# /wa/ only: expose hook.php, nothing else. Does not affect the rest of the site.
Options -Indexes
<IfModule mod_authz_core.c>
  Require all denied
  <Files "hook.php">
    Require all granted
  </Files>
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
  <Files "hook.php">
    Order allow,deny
    Allow from all
  </Files>
</IfModule>
